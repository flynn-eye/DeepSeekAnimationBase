{
  "name": "claude-animation-base",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Seeky the DeepSeek sprite, animated with PixiJS and an independent GPU natural-media brush engine",
  "scripts": {
    "dev": "node dev.mjs",
    "vendor:brush": "cp ../p5.brush/dist/pixi.brush.js ../p5.brush/dist/pixi.brush.js.map ../p5.brush/LICENSE.md vendor/p5.brush/",
    "sheet": "node render.mjs --sheet=0,1,2,3,4,5 --out=out/sheet.jpg",
    "video": "node render.mjs --clip --out=out/video.mp4"
  },
  "dependencies": {
    "p5.brush": "file:../p5.brush",
    "pixi.js": "^8.17.1",
    "puppeteer-core": "^25.11.0"
  }
}
